# Copy to .env and fill in.
AUTH_SECRET=change-me-64-hex-chars
APP_URL=http://localhost:3000
# Supabase Postgres connection string (session pooler recommended for serverless).
# Use the revisio_app role created via the Supabase MCP (least privilege, no Supabase Auth).
DATABASE_URL=postgresql://user:password@aws-0-<region>.pooler.supabase.com:5432/postgres
