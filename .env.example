[TEMPLATE]
# Copy to .env and fill in.
AUTH_SECRET=change-me-64-hex-chars
APP_URL=http://localhost:3000
# Supabase Postgres — transaction pooler (port 6543) is recommended for
# serverless deployments like Vercel. The session pooler (5432) caps at 15
# concurrent clients and will reject bursts of serverless traffic.
# Use the revisio_app role (least privilege, no Supabase Auth).
DATABASE_URL=postgresql://user:password@aws-1-<region>.pooler.supabase.com:6543/postgres
PGPOOL_MAX=5

# ── Neon read mirror (optional) ─────────────────────────────────────────────
# A second Postgres (Neon) kept in step with the primary by src/db/sync.ts.
# Reads that tolerate second-scale staleness (dashboards, /me, leaderboards,
# catalogues, lesson text) go here; auth, the review write path and the queues
# the learner is dealt stay on the primary. Unset = single-database mode.
#
# One-time setup, in order:
#   1. Create the Neon project (region near your Vercel function region).
#   2. npm run neon:bootstrap   ← copies the schema + every current row over
#   3. npm run neon:init        ← installs _sync_events + capture triggers on BOTH dbs
#   4. Set NEON_DATABASE_URL here and in the Vercel project env, then deploy.
#
# NEON_DATABASE_URL=postgresql://user:password@ep-<name>-<id>.<region>.aws.neon.tech/neondb?sslmode=require
# NEON_POOL_MAX=5
#
# Streaming: every write is captured by triggers into _sync_events on both
# databases and drained by the minute-cron (GET /api/v1/sync?action=run, see
# vercel.json — requires CRON_SECRET below), plus a drain kicked after each
# submitted review. An always-on alternative to the cron:
#   npm run neon:watch
# CRON_SECRET=change-me-random-string
