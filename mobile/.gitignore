# The native clients are committed source, unlike the generated Capacitor
# projects they replace. Only their build output is ignored.

# Android / Gradle
android/.gradle/
android/.kotlin/
android/local.properties
android/**/build/

# iOS / SwiftPM. The Xcode project at ios/Revisio.xcodeproj is committed source
# too — it is what CI archives — so only derived output and per-user state are
# ignored.
ios/.build/
ios/.swiftpm/
ios/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcuserstate

.DS_Store
