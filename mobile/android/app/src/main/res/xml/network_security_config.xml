<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext for exactly the local development hosts, and nothing else.

  10.0.2.2 is how the emulator reaches the machine that hosts it, and localhost
  is the device's own loopback. Both are only ever a server a developer is
  running, which is the one case where a plain-HTTP base URL is legitimate.

  The alternative — `android:usesCleartextTraffic="true"` on the application —
  would have been one line and would have permitted *any* http URL the app was
  ever pointed at, so a redirected or injected URL could silently downgrade a
  signed-in session. Everything not named here stays TLS-only, including the
  deployment the release builds are compiled against.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
